<UserControl x:Class="TMIAutomation.View.ConfigTabItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:viewmodel="clr-namespace:TMIAutomation.ViewModel"
             xmlns:converters="clr-namespace:TMIAutomation.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodel:ConfigViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/ButtonTheme.xaml"/>
                <ResourceDictionary Source="../Theme/ComboBoxTheme.xaml"/>
                <ResourceDictionary Source="../Theme/TextBlockTheme.xaml"/>
                <ResourceDictionary Source="../Theme/TextBoxTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#3F3D56"/>
                <Setter Property="Foreground" Value="#FDFDFD"/>
                <Setter Property="BorderBrush" Value="#57537A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
                <Setter Property="ToolTipService.BetweenShowDelay" Value="100"/>
                <Setter Property="ToolTipService.ShowDuration" Value="{x:Static sys:Int32.MaxValue}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#272537">
        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="60,45,0,0"
                   Style="{StaticResource TextBlockTheme}"
                   Text="Dose per fraction [Gy]"
                   ToolTip="The dose per fraction in Gray (e.g., 2.0)"/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="245,45,0,0"
                   Background="#57537A"
                   Style="{StaticResource TextBlockTheme}"
                   Text="{Binding DosePerFraction}"/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="440,45,0,0"
                   Style="{StaticResource TextBlockTheme}"
                   Text="Number of fractions"
                   ToolTip="The total number of fractions"/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="600,45,0,0"
                   Background="#57537A"
                   Style="{StaticResource TextBlockTheme}"
                   Text="{Binding NumberOfFractions}"/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="60,105,0,0"
                   Style="{StaticResource TextBlockTheme}"
                   Text="Treatment machine"
                   ToolTip="The treatment machine. Should match Eclipse machine names."/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="245,105,0,0"
                   Background="#57537A"
                   Style="{StaticResource TextBlockTheme}"
                   Text="{Binding TreatmentMachine}"/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="63,145,0,0"
                   Style="{StaticResource TextBlockTheme}"
                   Text="MLC Identifier"
                   ToolTip="The MLC identifier of the machine"/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="245,145,0,0"
                   Background="#57537A"
                   Style="{StaticResource TextBlockTheme}"
                   Text="{Binding MLCId}"/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="440,103,0,0"
                   Style="{StaticResource TextBlockTheme}"
                   Text="Energy"
                   ToolTip="The beam energy. Should match Eclipse energy names."/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="600,103,0,0"
                   Background="#57537A"
                   Style="{StaticResource TextBlockTheme}"
                   Text="{Binding Energy}"/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="440,145,0,0"
                   Style="{StaticResource TextBlockTheme}"
                   Text="Dose rate [MU/min]"
                   ToolTip="The dose rate (e.g. 600)"/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="600,145,0,0"
                   Background="#57537A"
                   Style="{StaticResource TextBlockTheme}"
                   Text="{Binding DoseRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="60,205,0,0"
                   Style="{StaticResource TextBlockTheme}"
                   Text="Optimization algorithm"
                   ToolTip="Optimization algorithm. Should match Eclipse optimizer names."/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="245,205,0,0"
                   Background="#57537A"
                   Style="{StaticResource TextBlockTheme}"
                   Text="{Binding OptimizationAlgorithm}"/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="440,205,0,0"
                   Style="{StaticResource TextBlockTheme}"
                   Text="Dose algorithm"
                   ToolTip="The dose algorithm. Should match Eclipse dose algorithm names."/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="600,205,0,0"
                   Background="#57537A"
                   Style="{StaticResource TextBlockTheme}"
                   Text="{Binding DoseAlgorithm}"/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="60,265,0,0"
                   Style="{StaticResource TextBlockTheme}"
                   Text="{Binding PlanningLabel}"
                   ToolTip="{Binding TooltipPlanningLabel}"/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="245,265,0,0"
                   Background="#57537A"
                   Style="{StaticResource TextBlockTheme}"
                   Text="{Binding SelectedPlanningOption}"/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="440,265,0,0"
                   Style="{StaticResource TextBlockTheme}"
                   Text="Collimator angle"
                   ToolTip="The collimator angle of the fields in the lower-extremities plan"/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="600,265,0,0"
                   Style="{StaticResource TextBlockTheme}"
                   Background="#57537A"
                   Text="{Binding LowerExtremitiesCollimator}"/>

        <Button HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,325,0,0"
                Content="Reload configuration"
                FontSize="20"
                Width="250"
                Command="{Binding ReloadConfigurationCommand}"/>

        <Button HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,10,10"
                Content="Open script configuration"
                FontSize="12"
                Width="160"
                Command="{Binding OpenConfigurationCommand}"/>

    </Grid>
</UserControl>
